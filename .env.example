# ── Grok Standalone Farmer ──────────────────────────────────────────────────
# Copy to .env and edit:  cp .env.example .env

# IMAP inbox that receives OTP (Gmail App Password recommended)
GROK_IMAP_USER=you@gmail.com
GROK_IMAP_PASS=xxxx xxxx xxxx xxxx
GROK_IMAP_HOST=imap.gmail.com
GROK_IMAP_PORT=993

# Email mode: domain | plus_trick
# domain     = random@catch-all (needs working catch-all → IMAP)
# plus_trick = you+random@gmail.com (OTP lands in same Gmail)
GROK_EMAIL_MODE=domain

# Catch-all domain(s) — multi-domain enterprise pool (comma-separated)
# Prefer GROK_EMAIL_DOMAINS; legacy GROK_EMAIL_DOMAIN still works (merged).
# Each domain must have Cloudflare (or DNS) catch-all → IMAP inbox Active.
GROK_EMAIL_DOMAINS=budgezen.com,mypapyr.com
# Legacy single domain (optional if DOMAINS set):
# GROK_EMAIL_DOMAIN=budgezen.com

# Domain pick strategy: random | round_robin
# round_robin = A,B,A,B… across healthy domains (recommended multi-domain)
# random      = weighted random (identity.weight)
# GROK_EMAIL_DOMAIN_STRATEGY=round_robin

# Auto-skip a domain after N consecutive farm/OTP failures (domain_stats).
# Default 3. Set high to effectively disable auto-skip.
# GROK_DOMAIN_MAX_CONSECUTIVE_FAILS=3

# Optional multi-IMAP map (domain → inbox). See identities.example.json
# When unset, all domains share GROK_IMAP_* above.
# GROK_IDENTITY_FILE=~/grok-farm/identities.json

# Gmail base for plus_trick (optional; defaults to GROK_IMAP_USER)
# GROK_GMAIL_BASE=you@gmail.com

# Account password for all farmed xAI accounts
GROK_PASSWORD=@YourAccountGrokPass

# How many accounts to create this run
GROK_MAX_ACCOUNTS=5
# Concurrent browsers (farm.py / brutal_farmer base). Prod default 3 (see docs/CAPACITY.md).
GROK_CONCURRENT=3
# Adaptive concurrent (brutal_farmer): scale base using domain_stats + proxy_stats scores.
# GROK_ADAPTIVE_CONCURRENT=1   # 1=on (default) | 0=fixed GROK_CONCURRENT only
# GROK_CONCURRENT_MIN=1
# GROK_CONCURRENT_MAX=5        # hard ceiling; do not raise without RAM headroom

# false = headed browser (recommended — Turnstile much more reliable)
# true  = headless (needs DISPLAY-less server; Turnstile may fail more)
GROK_HEADLESS=false

# Optional delay (seconds) between account spawns
GROK_SPAWN_DELAY=2

# Terminal UI: hud (default on TTY) | log (classic line spam)
# GROK_UI=hud
# GROK_VERBOSE=true   # show detail lines even with HUD (also always in farm.log)

# Fail-fast timeouts (stuck/unclear states free the worker slot)
# GROK_OTP_TIMEOUT=120          # IMAP wait for code
# GROK_CONFIRM_TIMEOUT=45       # still on Verify page → fail
# GROK_COMPLETE_TIMEOUT=90      # Turnstile/complete form stuck → fail
# GROK_ACCOUNT_TIMEOUT=480      # whole account hard deadline (8 min)

# ── Proxies (recommended for concurrent >1 / Turnstile) ─────────────────────
# Preferred: list file (one proxy per line). See proxies.txt.example
# GROK_PROXY_FILE=./proxies.txt
# If GROK_PROXY_FILE unset and ./proxies.txt exists, it is loaded automatically.
# GROK_PROXY_SHUFFLE=false
# Optional extra inline pool (merged with file), optional #id per entry:
# GROK_PROXY_POOL=http://user:pass@host:port,socks5://user:pass@host:port#node2

# Optional vision CAPTCHA (interactive puzzles only; managed Turnstile uses click)
# GROK_CAPTCHA_PROXY_URL=https://api.openai.com/v1/chat/completions
# GROK_CAPTCHA_API_KEY=sk-...
# GROK_CAPTCHA_MODEL=gpt-4o

# Results: each run creates results/batch_<timestamp>/ automatically
# GROK_RESULTS_DIR=./results
# Global email index (dedup across all batches) — auto-maintained
# GROK_USED_EMAILS_FILE=./results/used_emails.txt
# Local-part style for domain (and plus_trick tag):
#   realistic — human names: john.smith / j.smith92 / mary_jones (default, offline)
#   crypto    — alnum secrets (legacy hash-like: a7k2…)
#   parser    — parser.name API (needs key) + offline fallback if rate-limited
# GROK_EMAIL_LOCAL_STYLE=realistic
# Local-part length only for crypto style (default 16)
# GROK_EMAIL_LOCAL_LEN=16
# Optional parser.name (https://parser.name) — free ~100 req/day, not enough alone for farming
# GROK_PARSER_NAME_API_KEY=
# GROK_PARSER_NAME_COUNTRY=US
# GROK_PARSER_NAME_BATCH=5
# Name corpus region: mixed (default) | id | en | intl
# mixed ≈ 45% Indonesian (data/names_id.txt from gist maulvi) + EN + intl
# GROK_NAME_REGION=mixed
# Drop more word lists into data/names_extra_first.txt / names_extra_last.txt (one name per line)
# Or: GROK_NAME_FIRST_FILES=/path/a.txt,/path/b.txt
# Optional fixed batch id: GROK_BATCH_ID=my_batch_01
# Legacy single-file mode (disables per-batch folders):
# GROK_RESULTS_JSON=./results/accounts.json
# GROK_RESULTS_TXT=./results/accounts.txt
# GROK_FAILED_JSON=./results/failed.json
# GROK_SCREENSHOT_DIR=./screenshots

# ── Inventory / health / inject (ops) ───────────────────────────────────────
# GROK_AKUN_DB=~/grok-farm/akun.db
# GROK_FARM_DIR=~/grok-farm
# Optional Discord-compatible webhook (JSON {"content":"..."}); body is redacted
# Used by workflow.py inject alerts + scripts/health_check.sh (hard issues only, exit 3)
# GROK_ALERT_WEBHOOK=https://discord.com/api/webhooks/xxx/yyy
# GROK_FARM_ALERT_WEBHOOK=   # alias of GROK_ALERT_WEBHOOK
# Optional Telegram Bot API (preferred for ops). Never commit real token.
# GROK_TELEGRAM_BOT_TOKEN=
# GROK_TELEGRAM_CHAT_ID=
# Private-chat animated message effects (🎉/🔥/⚡…). Default on; set 0 to disable.
# GROK_TELEGRAM_EFFECTS=1
# Debounce same title+issues fingerprint (minutes; 0=off). Default 60.
# GROK_ALERT_DEBOUNCE_MIN=60
# Health timer schedule is systemd (every 15 min); not controlled by env
# Daily digest + proxy dashboard timer: systemd OnCalendar ~01:00 UTC (+ ≤5m random)
# Optional host tag in digest title (default = hostname short)
# GROK_HOST_TAG=grok4
# Fleet-wide digest (1 Telegram/day): each host uploads snapshot to S3; leader posts once.
# Requires ~/.config/grok-farm/backup.env (same S3 as age backup). Set GROK_FLEET_DIGEST=0 for per-host cards.
# GROK_FLEET_DIGEST=1
# GROK_FLEET_DIGEST_HOSTS=grok3,grok4,grok5,grok6,grok7
# GROK_FLEET_DIGEST_LEADER_HOST=grok3   # or GROK_FLEET_DIGEST_LEADER=1 on one host only
# GROK_FLEET_DIGEST_WAIT_SEC=900        # leader wait for peer snapshots
# GROK_FLEET_DIGEST_PREFIX=farm-vps/fleet-digest
# Soft proxy skip after N consecutive inject/farm fails (proxy_stats; fail-open). Default 5.
# GROK_PROXY_MAX_CONSECUTIVE_FAILS=5
# Soft probe timer batch size (scripts/probe_soft.sh). Default 100.
# GROK_PROBE_TIMER_LIMIT=100
# 9router SSH inject overrides (defaults match production gateway)
# GROK_9R_SSH=root@49.12.82.34
# GROK_9R_PORT=39999
# GROK_9R_KEY=~/.ssh/id_ed25519
# Remote list helper for reconcile (default /root/list_grok_connections.py)
# GROK_9R_LIST_CONNECTIONS=/root/list_grok_connections.py

# Live JWT probe (soft inventory — does not flip injected→error by default)
# GROK_PROBE_URL=https://api.x.ai/v1/models
# GROK_PROBE_TIMEOUT=15
# GROK_PROBE_SKIP_EXPIRED=1    # offline JWT exp → jwt_expired without HTTP
# GROK_PROBE_LIMIT=20          # default for check_status --probe
# GROK_PROBE_DELAY=0           # inter-request delay (s) for large soft probe batches
# GROK_PROBE_PROGRESS_EVERY=25 # progress every N (0=off)
# GROK_PROBE_COMMIT_EVERY=50   # periodic commit for resume-safe long runs (0=end only)

# ── S3 backup (NOT in this file on VPS — use ~/.config/grok-farm/backup.env) ─
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://is3.cloudhost.id
# S3_BUCKET=grok-farm
# S3_PREFIX=farm-vps
# AGE_RECIPIENT=age1...          # public key only
# BACKUP_ENCRYPT=age             # age | none (none = emergency only)
# RETENTION_DAYS=14              # delete dated *.tgz.age under prefix/host older than N days (keeps latest.* + LATEST.txt)
# Host for retention prefix is hostname -s at backup time
