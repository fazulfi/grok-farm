[Unit]
Description=Grok Farm soft token probe (inventory meta only)
Documentation=https://github.com/fazulfi/grok-farm
After=network-online.target

[Service]
Type=oneshot
User=USER
Group=USER
WorkingDirectory=/home/USER/grok-farm
ExecStart=/bin/bash /home/USER/grok-farm/scripts/probe_soft.sh
Nice=10
PrivateTmp=true
