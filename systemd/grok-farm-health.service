[Unit]
Description=Grok Farm inventory health check (check_status + optional webhook)
Documentation=https://github.com/fazulfi/grok-farm
After=network-online.target

[Service]
Type=oneshot
User=magadirxwin
Group=magadirxwin
WorkingDirectory=/home/magadirxwin/grok-farm
ExecStart=/bin/bash /home/magadirxwin/grok-farm/scripts/health_check.sh
Nice=10
PrivateTmp=true
