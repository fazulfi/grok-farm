[Unit]
Description=Grok Farm — unlimited farm/import/inject loop
Documentation=https://github.com/fazulfi/grok-farm
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# IMPORTANT: non-root user that owns Camoufox cache (~/.cache/camoufox)
User=magadirxwin
Group=magadirxwin
WorkingDirectory=/home/magadirxwin/grok-farm
ExecStart=/bin/bash /home/magadirxwin/grok-farm/brutal_farmer.sh
Restart=always
RestartSec=30
StandardOutput=append:/home/magadirxwin/grok-farm/farm_brutal.log
StandardError=append:/home/magadirxwin/grok-farm/farm_brutal.log
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
