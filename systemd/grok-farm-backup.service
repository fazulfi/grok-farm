[Unit]
Description=Grok Farm age-encrypted backup (local or S3)
Documentation=https://github.com/fazulfi/grok-farm
After=network-online.target

[Service]
Type=oneshot
User=magadirxwin
Group=magadirxwin
WorkingDirectory=/home/magadirxwin/grok-farm
ExecStart=/bin/bash /home/magadirxwin/grok-farm/scripts/local_age_backup.sh
Nice=10
PrivateTmp=true
