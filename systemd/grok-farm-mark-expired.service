[Unit]
Description=Grok Farm mark expired farmed tokens (farmed only)
Documentation=https://github.com/fazulfi/grok-farm
After=network-online.target

[Service]
Type=oneshot
User=USER
Group=USER
WorkingDirectory=/home/USER/grok-farm
ExecStart=/bin/bash /home/USER/grok-farm/scripts/mark_expired_farmed.sh
Nice=10
PrivateTmp=true
