# ── Grok Farm v2 (metode baru) — .env tambahan ──────────────────────────────
# Copy dari .env.example biasa → lalu isi juga blok V2_* di bawah ini:
#   cp .env.example .env  &&  nano .env
# farm_v2.py baca .env yang sama, tapi pakai prefix V2_ agar tidak bentrok.

# ── Password akun Grok yang akan difarm (min 16 char, campur) ───────────────
V2_PASSWORD=ChangeMe-Strong-Pass-2026!

# ── MAILLDEZ-compatible temp-mail API (WAJIB untuk farm) ────────────────────
# Reference: https://github.com/ilhmlnaa/tempmail-worker (internal)
# API shape: GET /api/session → POST /api/inboxes {domain} → GET .../messages
V2_MAILLDEZ_URL=https://your-mail-api.example
# Domain dipakai round-robin (comma-separated, catch-all aktif):
V2_MAILLDEZ_DOMAINS=maildomain1.com,maildomain2.com

# ── 9Router (opsional, untuk auto-add akun) ─────────────────────────────────
V2_ROUTER9_URL=https://your-9router.example
V2_ROUTER9_PASS=change-me

# ── Engine ───────────────────────────────────────────────────────────────────
# false = headed (disarankan, dimuat via xvfb-run), true = headless
V2_HEADLESS=false
# Proxy per-run opsional (http://user:pass@host:port) — kosongkan jika pakai proxy file
V2_PROXY=

# ── Output ───────────────────────────────────────────────────────────────────
V2_OUT=./v2_sso.txt

