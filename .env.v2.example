# ── OAuth scope / referrer / version (INTEL 2026-08-07: health token) ───────
# Akun yang "thinking jalan" punya scope `... conversations:read conversations:write`
# + referrer cocok (grok-build / cli-proxy-api). Default sudah menyetel itu.
# Kalau xAI rilis scope baru → tambahkan di sini.
V2_OAUTH_SCOPE=openid profile email offline_access grok-cli:access api:access conversations:read conversations:write
V2_OAUTH_REFERRER=grok-build
V2_CLIENT_VERSION=0.1.0

